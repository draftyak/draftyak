{
  "components": {
    "schemas": {
      "draftyak.entities.OwnerSettings": {
        "$defs": {
          "draftyak.entities.Weekday": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "type": "string"
          },
          "draftyak.entities.WorkingHours": {
            "additionalProperties": false,
            "description": "The owner's working days and hours, HH:mm in their zone, start before end; the default is mon to fri, 09:00 to 17:00.",
            "properties": {
              "days": {
                "items": {
                  "$ref": "#/components/schemas/draftyak.entities.OwnerSettings/$defs/draftyak.entities.Weekday"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "end": {
                "maxLength": 5,
                "minLength": 5,
                "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$(?![\\s\\S])",
                "type": "string"
              },
              "start": {
                "maxLength": 5,
                "minLength": 5,
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$(?![\\s\\S])",
                "type": "string"
              }
            },
            "required": [
              "days",
              "start",
              "end"
            ],
            "type": "object"
          },
          "draftyak.tool-v1.IanaZone": {
            "description": "An IANA time zone name, such as America/Chicago; Temporal checks that it exists.",
            "maxLength": 64,
            "not": {
              "pattern": "\\n"
            },
            "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$(?![\\s\\S])",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "The owner's time zone, which schedules and lookups use, and working hours.",
        "properties": {
          "workingHours": {
            "$ref": "#/components/schemas/draftyak.entities.OwnerSettings/$defs/draftyak.entities.WorkingHours"
          },
          "zone": {
            "$ref": "#/components/schemas/draftyak.entities.OwnerSettings/$defs/draftyak.tool-v1.IanaZone"
          }
        },
        "required": [
          "zone",
          "workingHours"
        ],
        "type": "object"
      }
    }
  },
