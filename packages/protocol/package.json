{
  "name": "@draftyak/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:heavy": "vitest run --mode heavy",
    "build": "tsdown",
    "prepack": "tsdown",
    "spec": "node scripts/export-spec.ts",
    "vectors": "node scripts/vectors.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "fast-check": "4.10.2",
    "tsdown": "0.23.1"
  }
}
