{
  "name": "@draftyak/plugin-testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsdown"
  },
  "dependencies": {
    "@draftyak/fakes": "workspace:*",
    "@draftyak/protocol": "workspace:*",
    "@draftyak/sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "peerDependencies": {
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "tsdown": "0.23.1",
    "zod": "4.6.7"
  }
}
