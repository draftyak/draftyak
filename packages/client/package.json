{
  "name": "@draftyak/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "node --test test/client.test.ts test/read-json.test.ts test/generated.test.ts",
    "build": "tsdown",
    "generate": "node ../../tools/openapi-drift/index.ts"
  },
  "dependencies": {
    "@draftyak/protocol": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@draftyak/openapi-drift": "workspace:*",
    "tsdown": "0.23.1"
  }
}
