    "options": { "maxChars": 26 },
    "expect": {
      "includes": ["Current synthetic message."],
      "excludes": ["CANARY_BEYOND_OUTPUT_BUDGET"],
      "maxChars": 26,
      "removals": ["truncated"]
    }
  },
