[
  {
    "id": "inline-display-none",
    "kind": "html",
    "input": "<p>Visible summary.</p><p style=\"display:none\">CANARY_DISPLAY_NONE</p>",
    "expect": {
      "includes": ["Visible summary."],
      "excludes": ["CANARY_DISPLAY_NONE"],
      "removals": ["hidden"]
    }
  },
  {
    "id": "inline-visibility-hidden",
    "kind": "html",
    "input": "<p>Visible summary.</p><div style=\"visibility:hidden\">CANARY_VISIBILITY</div>",
    "expect": {
      "includes": ["Visible summary."],
      "excludes": ["CANARY_VISIBILITY"],
      "removals": ["hidden"]
    }
  },
  {
    "id": "inline-opacity-zero",
    "kind": "html",
    "input": "<p>Visible summary.</p><div style=\"opacity:0\">CANARY_OPACITY</div>",
