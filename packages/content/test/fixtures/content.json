  {
    "id": "script-and-style-source",
    "kind": "html",
    "input": "<p>Visible summary.</p><script>CANARY_SCRIPT; fetch('https://example.test/secret')</script><style>/* CANARY_STYLE */ p { color: black; }</style>",
    "expect": {
      "includes": ["Visible summary."],
      "excludes": ["CANARY_SCRIPT", "CANARY_STYLE", "fetch("],
      "removals": ["hidden"]
    }
  },
  {
    "id": "template-and-comment-source",
    "kind": "html",
    "input": "<p>Visible summary.</p><!-- CANARY_COMMENT --><template><p>CANARY_TEMPLATE</p></template>",
    "expect": {
      "includes": ["Visible summary."],
      "excludes": ["CANARY_COMMENT", "CANARY_TEMPLATE"],
      "removals": ["hidden"]
    }
  },
  {
    "id": "entity-decoding-preserves-visible-words",
    "kind": "html",
    "input": "<p>Visible &amp; clear: caf&#233; &lt;sample&gt;.</p>",
    "expect": { "includes": ["Visible & clear: café <sample>."], "excludes": ["&amp;", "&#233;"] }
  },
  {
    "id": "encoded-invisible-characters",
    "kind": "html",
    "input": "<p>CA&#x200b;NARY_&#x202e;ENTITY</p>",
    "expect": {
      "includes": ["CANARY_ENTITY"],
      "excludes": ["\u200b", "\u202e"],
      "removals": ["invisible"]
    }
  },
  {
    "id": "bidi-controls",
    "kind": "text",
    "input": "Before \u202eCANARY_BIDI\u202c after \u2066isolated\u2069.",
    "expect": {
      "includes": ["Before CANARY_BIDI after isolated."],
      "excludes": ["\u202e", "\u202c", "\u2066", "\u2069"],
      "removals": ["invisible"]
    }
  },
  {
    "id": "zero-width-and-joiner-controls",
    "kind": "text",
    "input": "CA\u200bNA\u200cRY\u200d_INVISIBLE\u2060\ufeff",
