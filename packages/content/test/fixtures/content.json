    "kind": "text",
    "input": { "repeat": "Visible synthetic text. ", "count": 3000 },
    "expect": {
      "includes": ["Visible synthetic text."],
      "maxChars": 40000,
      "removals": ["truncated"]
    }
  },
  {
    "id": "conditional-css-conservative-hiding",
