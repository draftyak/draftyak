<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>com.draftyak.hub</string>
    <key>ProgramArguments</key>
    <array>
      <string>__DRAFTYAK_ROOT__/node</string>
      <string>--disable-sigusr1</string>
      <string>__DRAFTYAK_ROOT__/cli/draftyak.mjs</string>
      <string>serve</string>
    </array>
    <key>WorkingDirectory</key><string>__DRAFTYAK_DATA__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>Umask</key><integer>63</integer>
    <key>ProcessType</key><string>Background</string>
  </dict>
</plist>
