{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/fixtures",
      "!**/vendor",
      "!**/evidence",
      "!spec/vectors",
      "!spikes/*/vectors",
      "!**/*.lock.json",
      "!spec/**/*.schema.json",
      "!spikes/sched-clock/grit-check"
    ]
  },
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  }
}
