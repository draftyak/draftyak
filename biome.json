{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 1048576,
    "includes": [
      "**",
      "!**/fixtures",
      "!**/vendor",
      "!**/evidence",
      "!spec/vectors",
      "!spikes/*/vectors",
      "!**/*.lock.json",
      "!spec/**/*.schema.json",
      "apps/hub/src/outbox/**"
    ]
  },
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["apps/hub/src/outbox/**"],
      "plugins": ["./security/no-outbox-timers.grit"]
    }
  ]
}
