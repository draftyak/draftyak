      "confirmation": "confirmed",
      "capability": "admin",
      "request": "GmailFlowClientRequest",
      "requestBytes": 32768,
      "responseBytes": 8192,
      "response": "GmailFlowView"
    },
    {
      "id": "authorize",
      "method": "POST",
      "path": "/device/v1/accounts/gmail/flow/authorize",
