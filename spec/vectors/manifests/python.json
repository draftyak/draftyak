{
  "format": "draftyak.vectors.manifests.v1",
  "description": "Python is unavailable until its runtime contract is added.",
  "cases": [
    {
      "id": "python-unavailable",
      "manifest": {
        "id": "@example/chat",
        "version": "1.2.3",
        "kind": "channel",
        "contract": {
          "extension": "io.github.draftyak/channel",
          "version": 1
        },
        "sdk": "1.0.0",
        "runtime": "python",
        "isolation": "standard",
        "auth": {
          "kind": "token-paste",
          "scopes": [],
          "requiredGrantedScopes": []
        },
        "credentials": {
          "mode": "brokered",
          "urlSecrets": []
        },
        "permissions": {},
        "dataClasses": [
          "community.content"
        ],
        "license": "Apache-2.0",
        "egress": {
          "rules": [
            {
              "class": "send",
              "method": "POST",
              "host": "chat.example.com",
              "pathTemplate": "/v1/channels/{chat.channelId}/messages",
              "query": {
                "reply": "chat.threadTs"
              },
              "maxBytes": 32768,
              "timeoutMs": 10000
            }
          ]
        },
        "send": {
          "render": "json-template",
          "constants": {
            "msgtype": "m.text"
          },
          "template": {
            "rule": 0,
            "path": [
              "v1",
              "channels",
              {
                "bind": "chat.channelId"
              },
              "messages"
            ],
            "query": {
              "reply": {
                "bind": "chat.threadTs"
              }
            },
            "headers": {
              "content-type": "application/json"
            },
            "body": {
              "type": {
                "const": "msgtype"
              },
              "text": {
                "bind": "body.text"
              },
              "footer": {
                "bind": "body.footer"
              }
            }
          }
        }
      },
      "code": "RUNTIME_UNSUPPORTED",
      "structural": true
    }
  ]
}
