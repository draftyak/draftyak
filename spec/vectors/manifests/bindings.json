{
  "format": "draftyak.vectors.manifests.v1",
  "description": "Frozen snapshot binding projections and expected json-template rendering or refusal. Query names sort by UTF-16; repeated values retain recipient order. No renderer is provided here.",
  "cases": [
    {
      "id": "email-repeated-query-in-field-order",
      "template": {
        "rule": 0,
        "path": [
          "v1",
          "messages"
        ],
        "query": {
          "to": {
            "bind": "email.to"
          },
          "cc": {
            "bind": "email.cc"
          },
          "bcc": {
            "bind": "email.bcc"
          }
        },
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "text": {
            "bind": "body.textWithFooter"
          }
        }
      },
      "rules": [
        {
          "class": "send",
          "method": "POST",
          "host": "chat.example.com",
          "pathTemplate": "/v1/messages",
          "query": {
            "to": "email.to",
            "cc": "email.cc",
            "bcc": "email.bcc"
          },
          "maxBytes": 32768,
          "timeoutMs": 10000
        }
      ],
      "constants": {},
      "snapshot": {
        "outbox": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "body": {
          "text": "See you at 3",
          "footer": "Sent with DraftYak"
        },
        "email": {
          "to": [
            "second@example.com",
            "first@example.com"
          ],
          "cc": [
            "copy@example.com"
          ],
          "bcc": [
            "blind@example.com"
          ]
        }
      },
      "expected": {
        "path": "/v1/messages",
        "query": "bcc=blind%40example.com&cc=copy%40example.com&to=second%40example.com&to=first%40example.com",
        "body": {
          "text": "See you at 3\n\nSent with DraftYak"
        }
      }
    },
