{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftyak.com/spec/schemas/agent-session-v1.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "hub": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "A SHA-256 digest as 64 lower-case hex characters."
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "device": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A ULID: 26 upper-case Crockford base32 characters."
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "An instant as UTC milliseconds since the epoch, a safe integer."
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "An instant as UTC milliseconds since the epoch, a safe integer."
    },
    "session": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A ULID: 26 upper-case Crockford base32 characters."
    },
    "principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "grant",
            "token"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A ULID: 26 upper-case Crockford base32 characters."
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "account": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A ULID: 26 upper-case Crockford base32 characters."
    },
    "toolClass": {
      "type": "string",
      "enum": [
        "read",
        "draft",
        "organize"
      ]
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 900000
                },
                {
                  "type": "number",
                  "const": 3600000
                },
                {
                  "type": "number",
                  "const": 28800000
                }
              ]
            }
          },
          "required": [
            "kind",
            "durationMs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "call"
            },
            "method": {
              "type": "string",
              "enum": [
                "tools/call",
                "resources/read"
              ]
            },
            "paramsDigest": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256 digest as 64 lower-case hex characters."
            },
            "validForMs": {
              "type": "number",
              "const": 600000
            },
            "singleUse": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "kind",
            "method",
            "paramsDigest",
            "validForMs",
            "singleUse"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "hub",
    "epoch",
    "device",
    "nonce",
    "iat",
    "exp",
    "session",
    "principal",
    "account",
    "toolClass",
    "authorization"
  ],
  "additionalProperties": false
}
