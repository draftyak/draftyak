{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftyak.com/spec/schemas/scheduled-summary-v1.schema.json",
  "$ref": "#/$defs/draftyak.scheduled-summary.ScheduledSummary",
  "$defs": {
    "draftyak.scheduled-summary.ScheduledSummary": {
      "type": "object",
      "properties": {
        "scheduling": {
          "$ref": "#/$defs/draftyak.hub-runtime.SchedulingStatus"
        },
        "scopeHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "description": "A SHA-256 digest as 64 lower-case hex characters."
        },
        "pendingApprovalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingApprovalIds": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$(?![\\s\\S])",
            "description": "A ULID: 26 upper-case Crockford base32 characters."
          },
          "uniqueItems": true
        },
        "scheduledCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/draftyak.scheduled-summary.ScheduledItem"
          }
        }
      },
      "required": [
        "scheduling",
        "scopeHash",
        "pendingApprovalCount",
        "pendingApprovalIds",
        "scheduledCount",
        "items"
      ],
      "additionalProperties": false,
      "description": "Pending approvals and the next scheduled sends. Counts are totals; the lists hold the first 20 ids in ascending order and the next 5 sends. scopeHash is compared between reads, never recomputed by a device."
    },
    "draftyak.hub-runtime.SchedulingStatus": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "sidecar",
            "service"
          ]
        },
        "scheduler": {
          "type": "string",
          "enum": [
            "running",
            "unavailable"
          ]
        },
        "syncPaused": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "scheduler",
        "syncPaused"
      ],
      "additionalProperties": false,
      "description": "The hub's mode, its scheduler state and its own Pause sync state, which the hub keeps across restarts."
    },
    "draftyak.scheduled-summary.ScheduledItem": {
      "type": "object",
      "properties": {
        "outboxId": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$(?![\\s\\S])",
          "description": "A ULID: 26 upper-case Crockford base32 characters."
        },
        "accountId": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$(?![\\s\\S])",
          "description": "A ULID: 26 upper-case Crockford base32 characters."
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$(?![\\s\\S])",
          "description": "An owner-chosen account alias."
        },
        "destination": {
          "type": "string",
          "maxLength": 512,
          "not": {
            "pattern": "[\u0000-\u001f-­-­͏-͏؜-؜ᅟ-ᅠ឴-឵᠎-᠎​-​‎-‏ -‮⁠-⁯ㅤ-ㅤ﻿-﻿ﾠ-ﾠ￰-￻𛲠-𛲣𝅳-𝅺󠀀-󠃿󠇰-󠿿]"
          }
        },
        "destinationTruncated": {
          "type": "boolean"
        },
        "moreRecipients": {
          "type": "integer",
          "minimum": 0,
          "maximum": 299
        },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "now"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "at"
                },
                "notBefore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "An instant as UTC milliseconds since the epoch, a safe integer."
                },
                "zone": {
                  "$ref": "#/$defs/draftyak.tool-v1.IanaZone"
                },
                "localWallTime": {
                  "type": "string",
                  "minLength": 22,
                  "maxLength": 22,
                  "pattern": "^(?:(?:[0-9]{2}(?:[2468][048]|[13579][26]|0[48])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9][+-](?:[01][0-9]|2[0-3]):[0-5][0-9]$(?![\\s\\S])",
                  "not": {
                    "pattern": "-00:00$"
                  }
                },
                "latenessSec": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 900
                    },
                    {
                      "type": "number",
                      "const": 3600
                    },
                    {
                      "type": "number",
                      "const": 14400
                    },
                    {
                      "type": "number",
                      "const": 86400
                    }
                  ]
                },
                "holdIfNewInbound": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "notBefore",
                "zone",
                "localWallTime",
                "latenessSec",
                "holdIfNewInbound"
              ],
              "additionalProperties": false
            }
          ],
          "title": "Schedule",
          "description": "A frozen send time; zone resolution and DST/instant agreement are checked before approval.",
          "allOf": [
            {
              "properties": {
                "kind": {
                  "const": "at"
                }
              }
            }
          ]
        },
        "deliverBy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "An instant as UTC milliseconds since the epoch, a safe integer."
        }
      },
      "required": [
        "outboxId",
        "accountId",
        "alias",
        "destination",
        "destinationTruncated",
        "moreRecipients",
        "schedule",
        "deliverBy"
      ],
      "additionalProperties": false,
      "description": "A scheduled send as the tray and the Quit dialog show it: no body, subject, statement or credential."
    },
    "draftyak.tool-v1.IanaZone": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$(?![\\s\\S])",
      "description": "An IANA time zone name, such as America/Chicago; Temporal checks that it exists.",
      "not": {
        "pattern": "\\n"
      }
    }
  }
}
