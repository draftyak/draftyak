{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftyak.com/spec/schemas/snapshot-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "hub": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "description": "A SHA-256 digest as 64 lower-case hex characters."
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outbox": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A ULID: 26 upper-case Crockford base32 characters."
        },
        "account": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A ULID: 26 upper-case Crockford base32 characters."
        },
        "conversation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 26,
              "maxLength": 26,
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "description": "A ULID: 26 upper-case Crockford base32 characters."
            },
            {
              "type": "null"
            }
          ]
        },
        "render": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "POST",
                "PUT",
                "PATCH"
              ]
            },
            "url": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^https:[/][/](?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?[.])*[a-z](?:[a-z0-9-]*[a-z0-9])?(?::[1-9][0-9]{0,4})?[/](?:[A-Za-z0-9._~!$&'()*+,;=:@/-]|%(?:[01][0-9A-F]|2[0-9A-CF]|3[A-F]|40|5[B-E]|60|7[BCDF]|[89A-F][0-9A-F]))*(?:[?](?:[A-Za-z0-9._~!$&()*+,;=:@/?-]|%(?:[01][0-9A-F]|2[0-9A-CF]|3[A-F]|40|5[B-E]|60|7[BCDF]|[89A-F][0-9A-F]))+)?$",
              "description": "A canonical https URL: a lower-case DNS host, no userinfo, no port 443, no dot segments, percent-encoding in upper-case hex and never of an unreserved character, and no fragment.",
              "allOf": [
                {
                  "not": {
                    "pattern": "^https://[^/]+:443/"
                  }
                },
                {
                  "not": {
                    "pattern": "^https://[^/]+:(?:6553[6-9]|655[4-9][0-9]|65[6-9][0-9]{2}|6[6-9][0-9]{3}|[7-9][0-9]{4})/"
                  }
                },
                {
                  "not": {
                    "pattern": "^https://[^/]+/(?:[^?]*/)?[.]{1,2}(/|[?]|$)"
                  }
                }
              ]
            },
            "headersSha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256 digest as 64 lower-case hex characters."
            },
            "bodySha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "description": "A SHA-256 digest as 64 lower-case hex characters."
            }
          },
          "required": [
            "method",
            "url",
            "headersSha256",
            "bodySha256"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 100000,
              "not": {
                "pattern": "\\r"
              }
            },
            "footer": {
              "type": "string",
              "maxLength": 10000,
              "not": {
                "pattern": "\\r"
              }
            }
          },
          "required": [
            "text",
            "footer"
          ],
          "additionalProperties": false
        },
        "attachments": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "contentType": {
                "$ref": "#/$defs/draftyak.normalized-change.MediaType"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "description": "A SHA-256 digest as 64 lower-case hex characters."
              }
            },
            "required": [
              "filename",
              "contentType",
              "size",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "now"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "at"
                },
                "notBefore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "An instant as UTC milliseconds since the epoch, a safe integer."
                },
                "zone": {
                  "$ref": "#/$defs/draftyak.tool-v1.IanaZone"
                },
                "localWallTime": {
                  "type": "string",
                  "minLength": 22,
                  "maxLength": 22,
                  "pattern": "^(?:(?:[0-9]{2}(?:[2468][048]|[13579][26]|0[48])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9][+-](?:[01][0-9]|2[0-3]):[0-5][0-9]$",
                  "not": {
                    "pattern": "-00:00$"
                  }
                },
                "latenessSec": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 900
                    },
                    {
                      "type": "number",
                      "const": 3600
                    },
                    {
                      "type": "number",
                      "const": 14400
                    },
                    {
                      "type": "number",
                      "const": 86400
                    }
                  ]
                },
                "holdIfNewInbound": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "notBefore",
                "zone",
                "localWallTime",
                "latenessSec",
                "holdIfNewInbound"
              ],
              "additionalProperties": false
            }
          ],
          "title": "Schedule",
          "description": "A frozen send time; zone resolution and DST/instant agreement are checked before approval."
        },
        "source": {
          "type": "object",
          "properties": {
            "draft": {
              "type": "string",
              "minLength": 26,
              "maxLength": 26,
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "description": "A ULID: 26 upper-case Crockford base32 characters."
            },
            "rev": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "authors": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/draftyak.entities.DraftAuthor"
              }
            }
          },
          "required": [
            "draft",
            "rev",
            "authors"
          ],
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "const": "email"
        },
        "email": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/draftyak.entities.EmailAddress"
            },
            "to": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/draftyak.entities.EmailAddress"
              }
            },
            "cc": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/draftyak.entities.EmailAddress"
              }
            },
            "bcc": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/draftyak.entities.EmailAddress"
              }
            },
            "subject": {
              "type": "string",
              "maxLength": 2000,
              "not": {
                "pattern": "[\\r\\n]"
              }
            },
            "threadId": {
              "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
            },
            "inReplyTo": {
              "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
            },
            "references": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
              }
            }
          },
          "required": [
            "from",
            "to",
            "cc",
            "bcc",
            "subject",
            "references"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "to": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "cc": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "bcc": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      },
      "required": [
        "v",
        "hub",
        "epoch",
        "outbox",
        "account",
        "conversation",
        "body",
        "attachments",
        "schedule",
        "source",
        "kind",
        "email"
      ],
      "additionalProperties": false
    },
