  "title": "SendSnapshotV1",
  "description": "The exact frozen send content. Body and footer are Unicode 17 NFC with LF line endings; claim-time MIME fields are absent.",
  "$defs": {
    "draftyak.normalized-change.MediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9!#$&^_.+-]+[/][a-z0-9!#$&^_.+-]+$",
      "description": "A lower-case type/subtype without parameters, such as image/png.",
      "not": {
        "pattern": "\\n"
      }
    },
    "draftyak.tool-v1.IanaZone": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$",
      "description": "An IANA time zone name, such as America/Chicago; Temporal checks that it exists.",
      "not": {
        "pattern": "\\n"
      }
    },
    "draftyak.entities.DraftAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "ai",
            "agent",
            "plugin"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A ULID: 26 upper-case Crockford base32 characters."
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "Who wrote a revision: the owner (a user id), the hub's AI (an AI run id), an agent (a grant or agent token id) or a plugin (a plugin instance id)."
    },
    "draftyak.entities.EmailAddress": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[-A-Za-z0-9!#$%&'*+/=?^_`{|}~\\u00a1-\\u00ac\\u00ae-\\u034e\\u0350-\\u05ff\\u0606-\\u061b\\u061d-\\u06dc\\u06de-\\u070e\\u0710-\\u088f\\u0892-\\u08e1\\u08e3-\\u115e\\u1161-\\u167f\\u1681-\\u17b3\\u17b6-\\u180a\\u1810-\\u1fff\\u2010-\\u2027\\u2030-\\u205e\\u2070-\\u27ff\\u2801-\\u2fff\\u3001-\\u3163\\u3165-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufdff\\ufe10-\\ufefe\\uff00-\\uff9f\\uffa1-\\uffef]+(?:[.][-A-Za-z0-9!#$%&'*+/=?^_`{|}~\\u00a1-\\u00ac\\u00ae-\\u034e\\u0350-\\u05ff\\u0606-\\u061b\\u061d-\\u06dc\\u06de-\\u070e\\u0710-\\u088f\\u0892-\\u08e1\\u08e3-\\u115e\\u1161-\\u167f\\u1681-\\u17b3\\u17b6-\\u180a\\u1810-\\u1fff\\u2010-\\u2027\\u2030-\\u205e\\u2070-\\u27ff\\u2801-\\u2fff\\u3001-\\u3163\\u3165-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufdff\\ufe10-\\ufefe\\uff00-\\uff9f\\uffa1-\\uffef]+)*@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "not": {
        "pattern": "\\n"
      },
