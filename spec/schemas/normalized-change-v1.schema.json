{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftyak.com/spec/schemas/normalized-change-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "email.message"
        },
        "providerId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "threadId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "internalDate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "An instant as UTC milliseconds since the epoch, a safe integer."
        },
        "labelIds": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
          }
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "raw": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 26,
                  "maxLength": 26,
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$(?![\\s\\S])",
                  "description": "A ULID: 26 upper-case Crockford base32 characters."
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "description": "Bytes the hub holds, such as a host/fetch response saved as a blob."
            },
            {
              "type": "object",
              "properties": {
                "base64": {
                  "type": "string",
                  "maxLength": 87382,
                  "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$(?![\\s\\S])",
                  "description": "Bytes as unpadded, canonical base64url."
                }
              },
              "required": [
                "base64"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "kind",
        "providerId",
        "threadId",
        "internalDate",
        "labelIds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "email.deleted"
        },
        "providerId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        }
      },
      "required": [
        "kind",
        "providerId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "email.labels"
        },
        "providerId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "threadId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "labelIds": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
          }
        }
      },
      "required": [
        "kind",
        "providerId",
        "threadId",
        "labelIds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chat.message"
        },
        "channelId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "ts": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "threadTs": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "sentAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "An instant as UTC milliseconds since the epoch, a safe integer."
        },
        "author": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user",
                "bot"
              ]
            },
            "id": {
              "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "subtype": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
        },
        "text": {
          "type": "string",
          "maxLength": 40000
        },
        "editedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "An instant as UTC milliseconds since the epoch, a safe integer."
        },
        "files": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
              },
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "contentType": {
                "$ref": "#/$defs/draftyak.normalized-change.MediaType"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "contentType",
              "size"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "channelId",
        "ts",
        "sentAt",
        "author",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chat.deleted"
        },
        "channelId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "ts": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        }
      },
      "required": [
        "kind",
        "channelId",
        "ts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chat.conversation"
        },
        "channelId": {
          "$ref": "#/$defs/draftyak.normalized-change.ProviderId"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "type": {
          "$ref": "#/$defs/draftyak.normalized-change.ChatChannelType"
        },
        "external": {
          "type": "boolean"
        },
        "shared": {
          "type": "boolean"
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "archived": {
          "type": "boolean"
        },
        "member": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "channelId",
        "type",
        "external",
        "shared",
        "memberCount",
        "archived",
        "member"
      ],
      "additionalProperties": false
    }
  ],
  "title": "NormalizedChange",
  "description": "A change a channel reports and the hub applies; content in it is untrusted.",
  "$defs": {
    "draftyak.normalized-change.ProviderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$(?![\\s\\S])",
      "description": "A provider's own id, opaque to the hub: visible ASCII, no spaces.",
      "not": {
        "pattern": "\\n"
      }
    },
    "draftyak.normalized-change.MediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9!#$&^_.+-]+[/][a-z0-9!#$&^_.+-]+$(?![\\s\\S])",
      "description": "A lower-case type/subtype without parameters, such as image/png.",
      "not": {
        "pattern": "\\n"
      }
    },
    "draftyak.normalized-change.ChatChannelType": {
      "type": "string",
      "enum": [
        "dm",
        "group_dm",
        "public",
        "private"
      ],
      "description": "A direct message, a group direct message, or a public or private channel."
    }
  }
}
