root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
max_line_length = 100

[*.{json,jsonc,yaml,yml,toml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{rs,kt,kts,py}]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
