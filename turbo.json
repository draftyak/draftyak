{
  "$schema": "./node_modules/turbo/schema.json",
  "cacheDir": ".turbo/cache",
  "noUpdateNotifier": true,
  "globalDependencies": [
    ".node-version",
    "reserved-tests.ts",
    "rust-toolchain.toml",
    "tools/verify/lib/bootstrap.ts",
    "tsconfig.base.json",
    "vitest.shared.ts"
  ],
  "globalPassThroughEnv": [
    "DO_NOT_TRACK",
    "CI",
    "GITHUB_STEP_SUMMARY",
    "GNUPGHOME",
    "DRAFTYAK_GPG",
    "DRAFTYAK_UV",
    "DRAFTYAK_CACHE_DIR",
    "DRAFTYAK_ENV_LIVE",
    "DRAFTYAK_GATE_ROOT",
    "CARGO_HOME",
    "CARGO_TARGET_DIR",
    "CARGO_BUILD_JOBS",
    "RUSTUP_HOME",
    "JAVA_HOME",
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "PLAYWRIGHT_BROWSERS_PATH",
    "NoDefaultCurrentDirectoryInExePath"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["DRAFTYAK_RESERVED_TESTS", "DRAFTYAK_GATE_ROOT"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "env": ["DRAFTYAK_RESERVED_TESTS", "DRAFTYAK_GATE_ROOT"],
      "passThroughEnv": ["DRAFTYAK_TYPECHECK_MARKS"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DRAFTYAK_*"]
    },
    "test:heavy": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DRAFTYAK_*"]
    },
    "test:live": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DRAFTYAK_*"]
    },
    "test:device": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DRAFTYAK_*"]
    }
  }
}
