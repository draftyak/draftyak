# Names only. The real file is .env.live at the root of the main checkout, never in a worktree.
# Only the spike kit's loadEnvLive(), saveEnvLive() and deleteEnvLive() read or write it.
# Entries are deleted after each live session, once the tokens and grants are revoked.

# M0.20 S4c live connectors
DY_LIVE_FUNNEL_BASE_URL=

# M0.25 S6b Slack
DY_LIVE_SLACK_APP_TOKEN=
DY_LIVE_SLACK_USER_TOKEN=

# M0.27 S7b Sign in with ChatGPT; the API key is for the optional API-key mode
DY_LIVE_SIWC_ACCESS_TOKEN=
DY_LIVE_SIWC_REFRESH_TOKEN=
DY_LIVE_SIWC_CLIENT_ID=
DY_LIVE_SIWC_SESSION=
DY_LIVE_RESPONSES_API_KEY=

# M0.29 S8b Gmail
DY_LIVE_GMAIL_CLIENT_ID=
DY_LIVE_GMAIL_CLIENT_SECRET=
DY_LIVE_GMAIL_REFRESH_TOKEN=
DY_LIVE_GMAIL_AGENT_CLIENT_ID=
DY_LIVE_GMAIL_AGENT_CLIENT_SECRET=

# M0.31 S9b Messages API
DY_LIVE_MESSAGES_API_KEY=
