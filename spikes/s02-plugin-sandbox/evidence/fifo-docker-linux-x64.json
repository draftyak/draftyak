    "layout": {
      "fifos": "mkfifo -m 600 in a fresh 0700 temp dir, unlinked once both ends are open: no socket joins hub and plugin",
      "stdio": "stdin, stdout and stderr; no fd 3 and no NODE_CHANNEL_* (Fallback 1)",
      "fd3": "the stdio layout plus fd 3, a FIFO the plugin writes, with NODE_CHANNEL_FD=3",
      "stdoutParser": "lines tagged as host frames or MCP, each lane json-lines under the fd-3 decoder",
      "hostFrameTag": "0x1e",
      "maxMessageBytes": 1048576,
      "handleSends": "ten per mode, each ending ENOTSOCK in the plugin, with no byte read by the hub from the FIFO they went over",
      "endOfFile": "each FIFO the plugin writes ends at end-of-file, through libuv or at its exit through a non-blocking drain until read returns 0, or the hub closes it at a violation",
