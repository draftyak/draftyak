{
  "id": "@draftyak/channel-hello",
  "version": "0.0.0",
  "kind": "channel",
  "sdk": "1.0.0",
  "runtime": "node",
  "isolation": "standard",
  "contract": { "extension": "io.github.draftyak/channel", "version": 1 },
  "auth": { "kind": "none", "scopes": [], "requiredGrantedScopes": [] },
  "credentials": { "mode": "brokered", "urlSecrets": [] },
  "permissions": {},
  "dataClasses": ["hello.content"],
  "license": "Apache-2.0",
  "egress": {
    "rules": [
      {
        "class": "read",
        "method": "GET",
        "host": "hello.draftyak.example",
        "pathTemplate": "/v1/me",
        "maxBytes": 32768,
        "timeoutMs": 1000
      },
      {
        "class": "read",
        "method": "GET",
        "host": "hello.draftyak.example",
        "pathTemplate": "/v1/conversations",
        "maxBytes": 32768,
        "timeoutMs": 1000
      },
      {
        "class": "read",
        "method": "GET",
        "host": "hello.draftyak.example",
        "pathTemplate": "/v1/conversations/{id}/messages",
        "query": ["cursor", "limit"],
        "maxBytes": 32768,
        "timeoutMs": 1000
      },
      {
        "class": "send",
        "method": "POST",
        "host": "hello.draftyak.example",
        "pathTemplate": "/v1/conversations/{chat.channelId}/messages",
        "query": { "idempotency_key": "outbox.id" },
        "maxBytes": 32768,
        "timeoutMs": 1000
      }
    ]
  },
  "send": {
    "render": "json-template",
    "constants": {},
    "template": {
      "rule": 3,
      "path": ["v1", "conversations", { "bind": "chat.channelId" }, "messages"],
      "query": { "idempotency_key": { "bind": "outbox.id" } },
      "headers": { "content-type": "application/json" },
      "body": { "text": { "bind": "body.textWithFooter" } }
    }
  }
}
